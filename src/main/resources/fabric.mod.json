{
	"schemaVersion": 1,
	"id": "granular_hunger",
	"version": "${version}",
	"name": "Granular Hunger",
	"description": "Granularizes the entire hunger system, and makes it configurable.",
	"authors": [
		"Tetro48"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/granular-hunger",
		"sources": "https://github.com/Tetro48/FabricMod-GranularHunger"
	},
	"license": "CC0-1.0",
	"icon": "assets/granular_hunger/icon.png",
	"environment": "*",
	"accessWidener": "granular_hunger.accesswidener",
	"entrypoints": {
		"main": [
			"tetro48.system.GranularHunger"
		],
		"client": [
			"tetro48.system.client.GranularHungerClient"
		],
		"modmenu": [
			"tetro48.system.client.compat.modmenu.ModMenuEntry"
		]
	},
	"mixins": [
		"granular_hunger.mixins.json",
		{
			"config": "granular_hunger.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}